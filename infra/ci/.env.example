# ==============================================================================
# OspreyDB — GitHub Actions Self-Hosted Runner Configuration
# ==============================================================================
# Copy this file to `infra/ci/.env` (gitignored) before starting the runner:
#   cp infra/ci/.env.example infra/ci/.env
#
# Never commit `infra/ci/.env` or any GitHub tokens to version control.
# ==============================================================================

# GitHub repository URL for runner registration
REPO_URL=https://github.com/ospreydb/ospreydb

# Option A (Recommended for persistent runners): GitHub Personal Access Token (PAT)
# with `repo` scope (classic) or `Administration: Read & Write` (fine-grained)
# for automatic token renewal on container restarts.
ACCESS_TOKEN=

# Option B (Short-lived 1h token): Generated in GitHub UI via:
#   Settings -> Actions -> Runners -> New self-hosted runner
# Leave empty if using ACCESS_TOKEN above.
RUNNER_TOKEN=

# Runner identity and labels
RUNNER_NAME=osprey-local-builder
RUNNER_LABELS=self-hosted,linux,x64,osprey-builder
RUNNER_GROUP=default

# Host Docker socket GID (auto-detected by `infra/ci/setup-runner.sh`)
DOCKER_GID=999
